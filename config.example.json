{
  // Порт HTTP/HTTPS сервера (UI, API, WebSocket)
  "port": 3000,

  // Пароль входа в /admin — смените перед вечеринкой
  "adminPassword": "changeme",

  // Порог vote_score для треков в очереди: если score ≤ этого числа — трек выкидывается (-2 = минимум 2 чистых дизлайка)
  "kickThreshold": -2,

  // Сколько отдельных дизлайков на текущий трек (Сейчас), чтобы его пропустить (не net-score)
  "playingKickDislikes": 3,

  // Максимум голосов одной сессии за окно voteRateWindowSec
  "voteRateLimit": 10,

  // Окно rate limit в секундах
  "voteRateWindowSec": 30,

  // Лимит размера загружаемого файла с телефона, в МБ
  "maxUploadMb": 100,

  // Максимальная длительность трека (YouTube, загрузка, библиотека). 0 = без лимита
  "maxTrackMinutes": 10,

  // true — только голосование, без добавления и загрузки треков (можно переключать в админке)
  "eventMode": false
}
