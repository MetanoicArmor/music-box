{
  "name": "music-box",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Local music voting server for parties",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:client": "vite",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-binaries.ps1",
    "release": "powershell -ExecutionPolicy Bypass -File scripts/build-release.ps1"
  },
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^8.1.0",
    "@fastify/websocket": "^11.0.2",
    "better-sqlite3": "^11.9.1",
    "fastify": "^5.2.2",
    "httpolyglot": "^0.1.2",
    "music-metadata": "^11.15.0",
    "qrcode": "^1.5.4",
    "selfsigned": "^5.5.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.14.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.1",
    "@types/selfsigned": "^2.0.4",
    "@types/uuid": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.5.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^6.2.5"
  }
}
